{
  "name": "portfel-inwestora-vercel",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "portfel-inwestora"
  ],
  "scripts": {
    "dev": "npm --workspace portfel-inwestora run dev --",
    "build": "npm --workspace portfel-inwestora run build",
    "start": "npm --workspace portfel-inwestora run start",
    "lint": "npm --workspace portfel-inwestora run lint",
    "gpw:audit": "npm --workspace portfel-inwestora run gpw:audit",
    "gpw:benchmark": "npm --workspace portfel-inwestora run gpw:benchmark",
    "gpw:anomalies": "npm --workspace portfel-inwestora run gpw:anomalies",
    "gpw:e2e": "npm --workspace portfel-inwestora run gpw:e2e",
    "gpw:mutation": "npm --workspace portfel-inwestora run gpw:mutation"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@10",
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
