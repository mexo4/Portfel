GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENFIGI_API_KEY=
EODHD_API_KEY=
# Optional path to a trusted PostgreSQL CA certificate. Keep the certificate outside the repository.
POSTGRES_CA_CERT_PATH=
# Alternative for serverless hosting: Base64-encoded trusted PostgreSQL CA certificate.
POSTGRES_CA_CERT_BASE64=
# Optional server-only diagnostics for ETF/OpenFIGI requests.
OPENFIGI_DIAGNOSTICS=
# Tymczasowa bezpieczna diagnostyka Stooq (loguje tylko symbol, status, cenę i datę sesji).
STOOQ_DIAGNOSTICS=
# Optional server-only diagnostics for Corporate Events GPW providers.
CORPORATE_EVENTS_DIAGNOSTICS=
