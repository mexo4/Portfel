[Unit]
Description=Mexo central GPW calendar synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/mexo/repo/portfel-inwestora
EnvironmentFile=/etc/mexo/gpw-calendar-sync.env
ExecStart=/usr/bin/node /opt/mexo/repo/portfel-inwestora/scripts/run-gpw-calendar-sync-release.mjs
TimeoutStartSec=30min
