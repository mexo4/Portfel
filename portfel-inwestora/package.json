{
  "name": "portfel-inwestora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca ../node_modules/next/dist/bin/next dev --webpack --hostname 127.0.0.1",
    "build": "next build",
    "start": "node --use-system-ca ./scripts/start-production.mjs",
    "test": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs --test tests/**/*.test.mjs",
    "audit:gpw-dividends": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/validate-gpw-dividends-official.mjs",
    "gpw:audit": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/run-gpw-quality-audit.mjs",
    "gpw:audit:fixtures": "npm run gpw:audit",
    "gpw:audit:sources": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/run-gpw-quality-sources.mjs",
    "gpw:audit:independent": "node scripts/run-gpw-automated-source-audit.mjs",
    "gpw:audit:projections": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/run-gpw-quality-projections.mjs",
    "gpw:audit:full": "node scripts/run-gpw-quality-full.mjs",
    "gpw:quality:gate": "node scripts/run-gpw-quality-gate.mjs",
    "gpw:benchmark": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/run-gpw-quality-benchmark.mjs",
    "gpw:anomalies": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/run-gpw-quality-anomalies.mjs",
    "gpw:e2e": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/run-gpw-quality-e2e.mjs",
    "gpw:e2e:postgres": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/run-gpw-quality-e2e.mjs --run-postgres --require-postgres",
    "gpw:http:e2e": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/run-gpw-quality-http-e2e.mjs",
    "gpw:readiness": "node scripts/run-gpw-readiness.mjs",
    "gpw:mutation": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/run-gpw-quality-mutation.mjs",
    "migrate:sqlite-to-postgres": "node --experimental-strip-types scripts/migrate-sqlite-to-postgres.ts",
    "migrate:sqlite-to-postgres:apply": "node --experimental-strip-types scripts/migrate-sqlite-to-postgres.ts --apply",
    "lint": "eslint",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@10",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "next": "16.4.2",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "^3.8.1",
    "resend": "^6.18.0",
    "tesseract.js": "^7.0.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-arm64-gnu": "4.2.1",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.1",
    "lightningcss-linux-x64-gnu": "1.31.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  },
  "type": "module"
}
